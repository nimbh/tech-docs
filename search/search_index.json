u0440\u0435\u0435 \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0435, \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u0440\u0430\u0431\u043e\u0442\u044b \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0439, \u043f\u043e\u0441\u0442\u0430\u0432\u043e\u043a \u0438 \u0441\u043a\u043b\u0430\u0434\u0441\u043a\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_2","title":"\u0410","text":"<p>\u0410\u0432\u0442\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u2014 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u0438\u043b (\u043e\u0441\u0442\u0430\u0442\u043a\u0438, \u043e\u0431\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u044c, \u043c\u0438\u043d/\u043c\u0430\u043a\u0441 \u0443\u0440\u043e\u0432\u0435\u043d\u044c). \u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u043d\u0443\u0436\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0441 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0431\u0435\u0437 \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_3","title":"\u0412","text":"<p>\u0412 \u043f\u0440\u0438\u0435\u043c\u043a\u0435 (\u043f\u0440\u0438\u0435\u043c\u043a\u0430) \u2014 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u043f\u0435\u0440\u0435\u0434\u0430\u043d\u043d\u044b\u0445 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u0443 \u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0438 \u043e\u043f\u0440\u0438\u0445\u043e\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u043a\u043b\u0430\u0434. \u0421\u0442\u0430\u0442\u0443\u0441 \u043c\u0435\u0436\u0434\u0443 \u0441\u0442\u0430\u0442\u0443\u0441\u0430\u043c\u0438 \u00ab\u0432 \u043f\u0443\u0442\u0438\u00bb \u0438 \u00ab\u0432 \u043d\u0430\u043b\u0438\u0447\u0438\u0438\u00bb.</p> <p>\u0412\u044b\u043a\u0443\u043f \u2014 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u043d\u044b\u0445 \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f\u043c\u0438 \u0437\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434. \u041d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043e\u0442\u043c\u0435\u043d\u044b \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u044b.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_4","title":"\u0417","text":"<p>\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u2014 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u0438 (\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f \u00ab\u041d\u0430 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0441\u043a\u043b\u0430\u0434\u00bb). \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u043e\u0437\u0430.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_5","title":"\u0418","text":"<p>\u0418\u043d\u0442\u0435\u0440\u0432\u0430\u043b \u2014 \u043f\u0435\u0440\u0438\u043e\u0434 \u043c\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u043c\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0441\u0442\u0430\u0442\u043a\u043e\u0432 \u0438\u043b\u0438 \u043e\u0431\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u043e\u0441\u0442\u0438). \u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u043d\u0438\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0430\u0432\u0438\u043b.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_6","title":"\u041a","text":"<p>\u041a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u043f\u0440\u0438\u0435\u043c\u043a\u0438 \u2014 \u0434\u043e\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u043f\u0440\u0438\u043d\u044f\u0442\u0430\u044f \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u043e\u043c \u0431\u0435\u0437 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0439 \u0441 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0438 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e\u043c. \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0445 \u0435\u0434\u0438\u043d\u0438\u0446 \u043a \u043e\u0431\u0449\u0435\u043c\u0443 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0443 \u0432 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0435.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_7","title":"\u041e","text":"<p>\u041e\u0441\u0442\u0430\u0442\u043a\u0438 \u2014 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u0435 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u0430, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0435 \u0434\u043b\u044f \u0437\u0430\u043a\u0430\u0437\u0430 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f\u043c\u0438. \u041e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0439 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_8","title":"\u041f","text":"<p>\u041f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u2014 \u043f\u0430\u0440\u0442\u0438\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u043e\u043c \u043d\u0430 \u0441\u043a\u043b\u0430\u0434 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u0430 \u0434\u043b\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u0418\u043c\u0435\u0435\u0442 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0438 \u0441\u0442\u0430\u0442\u0443\u0441 (\u0441\u043e\u0437\u0434\u0430\u043d\u0430, \u0432 \u043f\u0443\u0442\u0438, \u043d\u0430 \u043f\u0440\u0438\u0435\u043c\u043a\u0435, \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430).</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_9","title":"\u0421","text":"<p>\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 FBS \u2014 \u043f\u043b\u0430\u0442\u0430 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u0430 \u0437\u0430 \u0437\u0430\u0431\u043e\u0440 \u0442\u043e\u0432\u0430\u0440\u0430 \u0441\u043e \u0441\u043a\u043b\u0430\u0434\u0430 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430 \u0438 \u0435\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044e. \u041c\u043e\u0436\u0435\u0442 \u0437\u0430\u0432\u0438\u0441\u0435\u0442\u044c \u043e\u0442 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043e\u0432 \u0442\u043e\u0432\u0430\u0440\u0430, \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u0438 \u0442\u0430\u0440\u0438\u0444\u043d\u043e\u0439 \u0437\u043e\u043d\u044b.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#_10","title":"\u0426","text":"<p>\u0426\u0435\u043b\u0435\u0432\u043e\u0439 \u043f\u0440\u0438\u0440\u043e\u0441\u0442 \u2014 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0433\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u044b\u0440\u0443\u0447\u043a\u0438, \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0437\u0430\u043a\u0430\u0437\u043e\u0432 \u0438\u043b\u0438 \u0434\u043e\u043b\u0438 \u0440\u044b\u043d\u043a\u0430) \u0437\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0435\u0440\u0438\u043e\u0434. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0430\u0432\u0442\u043e\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0439.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/glossary/#f","title":"F","text":"<p>FBS (Fulfillment by Seller) \u2014 \u0441\u0445\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u044b, \u043f\u0440\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u043e\u0432\u0430\u0440 \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430, \u0430 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0435\u0433\u043e \u043f\u0440\u0438 \u0437\u0430\u043a\u0430\u0437\u0435 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044e. \u041f\u0440\u043e\u0434\u0430\u0432\u0435\u0446 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0441\u0442\u0430\u0442\u043a\u0430\u043c\u0438 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439 \u0437\u0430\u043a\u0430\u0437\u043e\u0432.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/","title":"\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f Telegram","text":"","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#telegram","title":"\u041a\u0430\u043a \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 Telegram","text":"","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#1","title":"1. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043d\u0443\u0436\u043d\u044b\u0439 \u0447\u0430\u0442","text":"<p>\u041f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u043b\u0438\u0447\u043d\u044b\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u0433\u0440\u0443\u043f\u043f\u0443 \u0438\u043b\u0438 \u043a\u0430\u043d\u0430\u043b, \u043a\u0443\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u043e\u0437\u0436\u0435.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#2","title":"2. \u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435","text":"<p>\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0445\u043e\u0442\u0438\u0442\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#3","title":"3. \u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043c\u0435\u043d\u044e \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438","text":"<p>\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f:</p> <pre><code>- Android \u2014 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0441 \u0438\u043a\u043e\u043d\u043a\u043e\u0439 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u0438\u043a\u0430.\n\n- iPhone \u2014 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438.\n\n- Desktop/Web \u2014 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u043c\u044b\u0448\u0438 \u0438\u043b\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438.\n</code></pre>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#4","title":"4. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0443\u043d\u043a\u0442 \u00ab\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0437\u0436\u0435\u00bb","text":"<p>\u0412 \u043f\u043e\u044f\u0432\u0438\u0432\u0448\u0435\u043c\u0441\u044f \u043c\u0435\u043d\u044e \u0432\u0430\u043c \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438:</p> <pre><code>- \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0431\u0435\u0437 \u0437\u0432\u0443\u043a\u0430.\n\n- \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0437\u0436\u0435.\n\n- \u041a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u0432 \u0441\u0435\u0442\u0438.\n</code></pre> <p>\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 <code>\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0437\u0436\u0435</code>.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#5","title":"5. \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0434\u0430\u0442\u0443 \u0438 \u0432\u0440\u0435\u043c\u044f","text":"<p>\u0412\u0432\u0435\u0434\u0438\u0442\u0435:</p> <pre><code>- \u0414\u0430\u0442\u0443 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438.\n\n- \u0412\u0440\u0435\u043c\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438.\n</code></pre> <p>\u041d\u0438\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f (\u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c Telegram Premium): - \u041f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u044c:<code>\u0412\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f</code></p> <p>\u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043a\u043d\u043e\u043f\u043a\u043e\u0439 <code>\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c [\u0434\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f]</code>.</p>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]},{"location":"instructions/tg/#6","title":"6. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435","text":"<p>\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u043c \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439. \u0415\u0433\u043e \u043c\u043e\u0436\u043d\u043e:</p> <pre><code>- \u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c.\n\n- \u0423\u0434\u0430\u043b\u0438\u0442\u044c.\n\n- \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0441\u0440\u0430\u0437\u0443.\n\n- \u041f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\n</code></pre>","tags":["\u041f\u043e\u0440\u0442\u0444\u043e\u043b\u0438\u043e"]}]}